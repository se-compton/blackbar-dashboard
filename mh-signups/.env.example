# Copy values into the Netlify UI (Site configuration > Environment variables),
# scoped to Functions and to the deploy contexts that need them. Placeholders only.
# For local development only, copy this file to .env (git-ignored). Wrap values
# that contain "$" (the passphrase hash) in single quotes.

# demo = synthetic numbers, labeled DEMO DATA. live = real Lead Docket data.
# Unset behaves as demo. Any other value fails closed.
DATA_MODE=demo

# Reporting calendar. All day/week/month boundaries use this zone, not the phone's.
DASHBOARD_TIMEZONE=America/New_York
# MONDAY (default) or SUNDAY
WEEK_START=MONDAY

# Owned by Rex. Verify in the tenant's Lead Docket API console. Required when DATA_MODE=live.
LEAD_DOCKET_BASE_URL=
LEAD_DOCKET_API_KEY=

# Required in live mode. Generate with: npm run hash-passphrase  and  npm run gen-session-secret
DASHBOARD_PASSPHRASE_HASH=
SESSION_SECRET=
# Session length in days (1 to 365). Default 30.
SESSION_DAYS=30
